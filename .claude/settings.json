{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/lint-text-style.py\"",
            "timeout": 10,
            "statusMessage": "表記規約を適用中"
          }
        ]
      }
    ]
  }
}